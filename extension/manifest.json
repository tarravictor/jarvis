{
  "manifest_version": 3,
  "name": "J.A.R.V.I.S. YouTube Music Bridge",
  "version": "1.0.0",
  "description": "Connects the local J.A.R.V.I.S. voice assistant to an open YouTube Music tab.",
  "permissions": ["scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "file:///*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
